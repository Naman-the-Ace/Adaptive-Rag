# ── Adaptive RAG — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your values

# ─── Groq (Fast & Free) ───────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Google Gemini (Fallback) ─────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ─── Tavily Web Search ───────────────────────────────────────────────────────
TAVILY_API_KEY=your-tavily-api-key-here

# ─── MongoDB (for chat history) ──────────────────────────────────────────────
# Use MongoDB Atlas free tier or local Docker instance
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=adaptive_rag

# ─── RAG Backend ──────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── Auth Service ─────────────────────────────────────────────────────────────
AUTH_SERVICE_PORT=8080
JWT_SECRET=change-me-to-a-long-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_DATABASE_URL=sqlite+aiosqlite:///./users.db

# ─── Service URLs (for Streamlit frontend) ───────────────────────────────────
AUTH_SERVICE_URL=http://localhost:8080
RAG_SERVICE_URL=http://localhost:8000
